# Qbrowser local configuration (edit .env, never commit secrets)
QBROWSER_HOME=~/.qbrowser
QBROWSER_HOST=127.0.0.1
QBROWSER_PORT=8765
QBROWSER_API_TOKEN=
QBROWSER_USE_KEYRING=0
# Preferred native multimodal path: one model observes screenshots and returns GUI actions
QBROWSER_ENGINE=native
QBROWSER_PROVIDER=zai
QBROWSER_MODEL=
# Choose one: ZAI_API_KEY or DEEPSEEK_API_KEY (when QBROWSER_PROVIDER=deepseek)
ZAI_API_KEY=
DEEPSEEK_API_KEY=
QBROWSER_MODEL_API_KEY=
# Independent read-only outcome/action reviewer; use a different model from the executor.
QBROWSER_VERIFIER_PROVIDER=
QBROWSER_VERIFIER_MODEL=
QBROWSER_VERIFIER_BASE_URL=
QBROWSER_VERIFIER_API_KEY=
# Set to 1 to review each state-changing GUI action with the independent verifier model.
QBROWSER_ENABLE_ACTION_GUARD=0
# OpenRouter example: set provider=custom, base URL=https://openrouter.ai/api/v1,
# choose an image-input/tool-capable model ID, and place the key in private .env.
# Only set QBROWSER_BASE_URL for custom providers; official Z.ai / DeepSeek endpoints are built in
QBROWSER_BASE_URL=
QBROWSER_MAX_STEPS=80
QBROWSER_MAX_SECONDS=3600
QBROWSER_MAX_TOTAL_TOKENS=250000
QBROWSER_MAX_CONTEXT_TOKENS=60000
# Third-party executors are disabled unless individually allowlisted.
QBROWSER_ENABLE_EXECUTOR_PLUGINS=0
QBROWSER_EXECUTOR_ALLOWLIST=
# Optional Playwright browser tool. Install with `pip install -e '.[browser]'` and `playwright install chromium`.
QBROWSER_BROWSER_HEADLESS=1
QBROWSER_BROWSER_ALLOWED_HOSTS=
QBROWSER_MEMORY_EMBEDDINGS=0
QBROWSER_MEMORY_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Use distinct IDs only for truly isolated desktop/display sessions.
QBROWSER_DESKTOP_ID=
# Audio is sent only after an explicit document read and only to this configured endpoint.
QBROWSER_TRANSCRIPTION_BASE_URL=
QBROWSER_TRANSCRIPTION_MODEL=whisper-1
QBROWSER_TRANSCRIPTION_API_KEY=
QBROWSER_TRANSCRIPTION_TIMEOUT_SECONDS=180
# Document retention is disabled by default. Set 90 to purge old finished-job versions.
QBROWSER_ARTIFACT_RETENTION_DAYS=0
QBROWSER_SCREEN_WIDTH=1280
# Optional cost estimate. Set both rates to your current provider price per 1M tokens.
QBROWSER_INPUT_COST_PER_MILLION_USD=
QBROWSER_OUTPUT_COST_PER_MILLION_USD=
# Screenshots are normally memory-only. Opt into encrypted milestone evidence with:
# qbrowser evidence-key, then set its output as QBROWSER_EVIDENCE_KEY.
QBROWSER_CAPTURE_EVIDENCE=0
QBROWSER_EVIDENCE_KEY=
QBROWSER_EVIDENCE_RETENTION_DAYS=30
# Optional legacy Agent S3 engine: QBROWSER_ENGINE=agent_s
AGENT_S_PROVIDER=openai
AGENT_S_MODEL=gpt-5-2025-08-07
OPENAI_API_KEY=
AGENT_S_GROUND_PROVIDER=huggingface
AGENT_S_GROUND_URL=
AGENT_S_GROUND_MODEL=ui-tars-1.5-7b
AGENT_S_GROUND_API_KEY=
AGENT_S_GROUNDING_WIDTH=1920
AGENT_S_GROUNDING_HEIGHT=1080
AGENT_S_TIMEOUT_SECONDS=1800
QBROWSER_MAX_AGENT_LOG_BYTES=10485760
QBROWSER_LOG_RETENTION_DAYS=30

# Owner-directed delivery, requires paired local OpenClaw and manual --confirm
QBROWSER_OWNER_WHATSAPP=
